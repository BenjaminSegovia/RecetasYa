# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore: nunca se commitea.

# Token de LocalStack (lo da la consola de LocalStack al crear la cuenta).
LOCALSTACK_AUTH_TOKEN=tu-token-de-localstack

# Credenciales de las bases de datos PostgreSQL (las 4 usan el mismo usuario).
POSTGRES_USER=recetaya
POSTGRES_PASSWORD=cambia-esta-password

# Secreto para firmar/validar los JWT entre auth-service y los demas servicios.
# Debe tener al menos 32 caracteres (requisito de HMAC SHA-256).
JWT_SECRET=genera-aqui-un-secreto-largo-y-aleatorio

# Clave compartida para los endpoints internos entre servicios
# (PATCH /recetas/{id}/estado y GET /internal/usuarios/{username}).
INTERNAL_API_KEY=genera-aqui-otra-clave-interna-aleatoria

# Contraseña de los usuarios semilla de desarrollo (medico1 / farma1),
# que se crean solo si activas el perfil "seed".
SEED_PASSWORD=secret123-dev

# Orígenes permitidos para el frontend (CORS): desde dónde puede llamar a la
# API. Por defecto es el Live Server de VS Code en el puerto 5501; si cambias
# el puerto o sirves el frontend desde otro lado, agrégalo aquí (separado por
# comas).
FRONTEND_ORIGINS=http://localhost:5501,http://127.0.0.1:5501
