# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore: nunca se commitea.

# Token de LocalStack (lo da la consola de LocalStack al crear la cuenta).
LOCALSTACK_AUTH_TOKEN=tu-token-de-localstack

# Credenciales de las bases de datos PostgreSQL (las 4 usan el mismo usuario).
POSTGRES_USER=recetaya
POSTGRES_PASSWORD=cambia-esta-password

# Secreto para firmar/validar los JWT entre auth-service y los demas servicios.
# Debe tener al menos 32 caracteres (requisito de HMAC SHA-256).
JWT_SECRET=genera-aqui-un-secreto-largo-y-aleatorio
